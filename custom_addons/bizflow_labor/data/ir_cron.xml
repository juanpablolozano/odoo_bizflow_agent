<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_labor_create_period" model="ir.cron">
        <field name="name">Mano de obra: crear y calcular el periodo anterior</field>
        <field name="model_id" ref="model_bizflow_labor_period"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_previous_period()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_labor_hours_alert" model="ir.cron">
        <field name="name">Mano de obra: alertar tareas que superan horas planificadas</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_labor_hours_alert()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
