<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_labor_payslip" model="ir.actions.report">
        <field name="name">Rol de pago</field>
        <field name="model">bizflow.labor.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bizflow_labor.report_labor_payslip</field>
        <field name="print_report_name">'Rol de pago - %s - %s' % (object.employee_id.name, object.period_id.name)</field>
        <field name="binding_model_id" ref="model_bizflow_labor_line"/>
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_labor_period" model="ir.actions.report">
        <field name="name">Resumen y roles de pago</field>
        <field name="model">bizflow.labor.period</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bizflow_labor.report_labor_period</field>
        <field name="print_report_name">'Liquidacion - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_bizflow_labor_period"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
