<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_labor" model="ir.ui.view">
        <field name="name">hr.employee.form.bizflow.labor</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="bizflow_labor" string="Mano de obra" groups="hr.group_hr_user">
                    <group>
                        <group string="Pago">
                            <field name="labor_pay_rate"/>
                            <field name="labor_cost_factor"/>
                            <field name="labor_effective_cost_factor" readonly="1"/>
                        </group>
                        <group string="Costo para proyectos">
                            <field name="hourly_cost" readonly="labor_pay_rate"/>
                            <div colspan="2" class="text-muted" invisible="not labor_pay_rate">
                                El costo por hora se calcula solo: tarifa de pago × factor de costo cargado.
                                Es el costo que cargan los partes de horas a cada proyecto.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
