<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Liquidaciones por empleado / pendientes de pago -->
    <record id="view_labor_line_list" model="ir.ui.view">
        <field name="name">bizflow.labor.line.list</field>
        <field name="model">bizflow.labor.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-success="state == 'paid'">
                <field name="period_id"/>
                <field name="employee_id"/>
                <field name="hours_normal" sum="Total"/>
                <field name="hours_overtime" sum="Total"/>
                <field name="hours_extra" sum="Total"/>
                <field name="amount_total" sum="Total"/>
                <field name="cost_premium" optional="hide" sum="Total"/>
                <field name="payment_id" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge" decoration-warning="state in ('approved', 'posted')" decoration-success="state == 'paid'"/>
                <button name="action_print_payslip" type="object" icon="fa-print" title="Rol de pago"/>
            </list>
        </field>
    </record>

    <record id="view_labor_line_pivot" model="ir.ui.view">
        <field name="name">bizflow.labor.line.pivot</field>
        <field name="model">bizflow.labor.line</field>
        <field name="arch" type="xml">
            <pivot string="Liquidaciones por empleado">
                <field name="employee_id" type="row"/>
                <field name="date_from" interval="week" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_labor_line_search" model="ir.ui.view">
        <field name="name">bizflow.labor.line.search</field>
        <field name="model">bizflow.labor.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="period_id"/>
                <filter name="pending" string="Pendiente de pago" domain="[('state', 'in', ('approved', 'posted'))]"/>
                <filter name="paid" string="Pagado" domain="[('state', '=', 'paid')]"/>
                <filter name="with_warning" string="Con alertas" domain="[('warning', '!=', False)]"/>
                <group>
                    <filter name="group_employee" string="Empleado" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_period" string="Periodo" context="{'group_by': 'period_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_labor_line_pending" model="ir.actions.act_window">
        <field name="name">Pendiente de pago</field>
        <field name="res_model">bizflow.labor.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_pending': 1, 'search_default_group_period': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay pagos pendientes</p>
        </field>
    </record>

    <record id="action_labor_line_report" model="ir.actions.act_window">
        <field name="name">Liquidaciones por empleado</field>
        <field name="res_model">bizflow.labor.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('state', '!=', 'cancel')]</field>
    </record>

    <!-- Costo de mano de obra por proyecto -->
    <record id="view_labor_project_cost_list" model="ir.ui.view">
        <field name="name">bizflow.labor.line.project.list</field>
        <field name="model">bizflow.labor.line.project</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date_from"/>
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="hours_normal" sum="Total"/>
                <field name="hours_overtime" sum="Total"/>
                <field name="hours_extra" sum="Total"/>
                <field name="cost_timesheet" sum="Total"/>
                <field name="cost_premium" sum="Total"/>
                <field name="cost_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="period_state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_labor_project_cost_pivot" model="ir.ui.view">
        <field name="name">bizflow.labor.line.project.pivot</field>
        <field name="model">bizflow.labor.line.project</field>
        <field name="arch" type="xml">
            <pivot string="Costo de mano de obra por proyecto">
                <field name="project_id" type="row"/>
                <field name="date_from" interval="week" type="col"/>
                <field name="hours_total" type="measure"/>
                <field name="cost_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_labor_project_cost_graph" model="ir.ui.view">
        <field name="name">bizflow.labor.line.project.graph</field>
        <field name="model">bizflow.labor.line.project</field>
        <field name="arch" type="xml">
            <graph string="Costo de mano de obra por semana" type="bar" stacked="1">
                <field name="date_from" interval="week"/>
                <field name="project_id"/>
                <field name="cost_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_labor_project_cost_search" model="ir.ui.view">
        <field name="name">bizflow.labor.line.project.search</field>
        <field name="model">bizflow.labor.line.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="employee_id"/>
                <filter name="posted" string="Contabilizado o pagado" domain="[('period_state', 'in', ('posted', 'paid'))]"/>
                <filter name="not_cancel" string="Vigente" domain="[('period_state', '!=', 'cancel')]"/>
                <group>
                    <filter name="group_project" string="Proyecto" context="{'group_by': 'project_id'}"/>
                    <filter name="group_employee" string="Empleado" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_week" string="Semana" context="{'group_by': 'date_from:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_labor_project_cost" model="ir.actions.act_window">
        <field name="name">Costo de mano de obra por proyecto</field>
        <field name="res_model">bizflow.labor.line.project</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_not_cancel': 1}</field>
    </record>

    <!-- Horas por semana (sobre los partes de horas estándar) -->
    <record id="action_timesheet_hours_by_week" model="ir.actions.act_window">
        <field name="name">Horas por semana</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('project_id', '!=', False)]</field>
        <field name="search_view_id" ref="hr_timesheet_line_search_labor"/>
        <field name="context">{
            'pivot_row_groupby': ['employee_id', 'project_id'],
            'pivot_column_groupby': ['date:week'],
            'pivot_measures': ['unit_amount'],
            'graph_groupbys': ['date:week', 'project_id'],
            'graph_measure': 'unit_amount',
        }</field>
    </record>
    <record id="action_timesheet_hours_by_week_pivot" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="hr_timesheet.view_hr_timesheet_line_pivot"/>
        <field name="act_window_id" ref="action_timesheet_hours_by_week"/>
    </record>
    <record id="action_timesheet_hours_by_week_list" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="hr_timesheet.hr_timesheet_line_tree"/>
        <field name="act_window_id" ref="action_timesheet_hours_by_week"/>
    </record>
</odoo>
