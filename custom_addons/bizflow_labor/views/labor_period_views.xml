<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_labor_period_list" model="ir.ui.view">
        <field name="name">bizflow.labor.period.list</field>
        <field name="model">bizflow.labor.period</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-info="state == 'draft'" decoration-success="state == 'paid'">
                <field name="name"/>
                <field name="date_from" optional="hide"/>
                <field name="date_to" optional="hide"/>
                <field name="hours_normal" sum="Total"/>
                <field name="hours_overtime" sum="Total"/>
                <field name="hours_extra" sum="Total"/>
                <field name="amount_total" sum="Total"/>
                <field name="cost_premium" sum="Total" optional="show"/>
                <field name="warning_count" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state in ('approved', 'posted')" decoration-success="state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="view_labor_period_form" model="ir.ui.view">
        <field name="name">bizflow.labor.period.form</field>
        <field name="model">bizflow.labor.period</field>
        <field name="arch" type="xml">
            <form string="Liquidación de mano de obra">
                <header>
                    <button name="action_generate" type="object" string="Calcular" class="btn-primary"
                            invisible="state != 'draft' or line_ids" groups="hr_timesheet.group_timesheet_manager"/>
                    <button name="action_generate" type="object" string="Recalcular"
                            invisible="state != 'draft' or not line_ids" groups="hr_timesheet.group_timesheet_manager"/>
                    <button name="action_approve" type="object" string="Aprobar" class="btn-primary"
                            invisible="state != 'draft' or not line_ids" groups="hr_timesheet.group_timesheet_manager"/>
                    <button name="action_post" type="object" string="Contabilizar" class="btn-primary"
                            invisible="state != 'approved'" groups="hr_timesheet.group_timesheet_manager"/>
                    <button name="action_open_pay_wizard" type="object" string="Pagar" class="btn-primary"
                            invisible="state != 'posted'" groups="hr_timesheet.group_timesheet_manager"/>
                    <button name="action_print_payslips" type="object" string="Imprimir roles"
                            invisible="not line_ids"/>
                    <button name="action_reset_draft" type="object" string="Volver a borrador"
                            invisible="state not in ('approved', 'cancel')" groups="hr_timesheet.group_timesheet_manager"/>
                    <button name="action_unpost" type="object" string="Revertir contabilización"
                            invisible="state != 'posted'" groups="hr_timesheet.group_timesheet_manager"
                            confirm="Se cancelarán los asientos y los recargos analíticos. ¿Continuar?"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state not in ('draft', 'approved')" groups="hr_timesheet.group_timesheet_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,posted,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_timesheets" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="timesheet_count" widget="statinfo" string="Partes de horas"/>
                        </button>
                        <button name="action_view_moves" type="object" class="oe_stat_button" icon="fa-book" invisible="not move_count">
                            <field name="move_count" widget="statinfo" string="Asientos"/>
                        </button>
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money" invisible="not payment_count">
                            <field name="payment_count" widget="statinfo" string="Pagos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not warning_count">
                        Hay <field name="warning_count" class="oe_inline"/> empleado(s) con alertas: revise la columna "Alertas".
                    </div>
                    <group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="hours_total"/>
                            <field name="amount_total"/>
                            <field name="cost_premium"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Empleados">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" create="0" delete="0"
                                      decoration-warning="warning">
                                    <field name="employee_id" readonly="1"/>
                                    <field name="job_title" optional="show"/>
                                    <field name="pay_rate"/>
                                    <field name="hours_normal" sum="Total"/>
                                    <field name="hours_overtime" sum="Total"/>
                                    <field name="hours_extra" sum="Total"/>
                                    <field name="amount_normal" optional="hide" sum="Total"/>
                                    <field name="amount_overtime" optional="hide" sum="Total"/>
                                    <field name="amount_extra" optional="hide" sum="Total"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="cost_premium" optional="show" sum="Total"/>
                                    <field name="warning" optional="show"/>
                                    <field name="move_id" optional="hide"/>
                                    <field name="payment_id" optional="hide"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <button name="action_print_payslip" type="object" icon="fa-print" title="Rol de pago"/>
                                </list>
                            </field>
                        </page>
                        <page name="projects" string="Costo por proyecto">
                            <field name="project_line_ids" readonly="1">
                                <list>
                                    <field name="project_id"/>
                                    <field name="employee_id"/>
                                    <field name="hours_normal" sum="Total"/>
                                    <field name="hours_overtime" sum="Total"/>
                                    <field name="hours_extra" sum="Total"/>
                                    <field name="cost_timesheet" sum="Total"/>
                                    <field name="cost_premium" sum="Total"/>
                                    <field name="cost_total" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page name="note" string="Notas">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_labor_period_search" model="ir.ui.view">
        <field name="name">bizflow.labor.period.search</field>
        <field name="model">bizflow.labor.period</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="to_pay" string="Por pagar" domain="[('state', 'in', ('approved', 'posted'))]"/>
                <filter name="paid" string="Pagados" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="with_warnings" string="Con alertas" domain="[('warning_count', '>', 0)]"/>
                <filter name="not_cancel" string="Vigentes" domain="[('state', '!=', 'cancel')]"/>
                <group>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'date_from:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_labor_period" model="ir.actions.act_window">
        <field name="name">Liquidaciones de mano de obra</field>
        <field name="res_model">bizflow.labor.period</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_not_cancel': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree el periodo de liquidación</p>
            <p>Elija las fechas, pulse <b>Calcular</b> y Odoo clasifica las horas registradas en normales,
               suplementarias y extraordinarias, calcula el pago de cada empleado y el costo por proyecto.</p>
        </field>
    </record>
</odoo>
