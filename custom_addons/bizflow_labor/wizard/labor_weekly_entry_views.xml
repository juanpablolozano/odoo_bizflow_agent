<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_labor_weekly_entry_form" model="ir.ui.view">
        <field name="name">bizflow.labor.weekly.entry.form</field>
        <field name="model">bizflow.labor.weekly.entry</field>
        <field name="arch" type="xml">
            <form string="Carga semanal de cuadrilla">
                <group>
                    <group>
                        <field name="project_id" options="{'no_create': True}"/>
                        <field name="task_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="week_start"/>
                        <field name="name"/>
                    </group>
                </group>
                <div class="text-muted mb-2"><field name="days_label" readonly="1"/></div>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="employee_id" options="{'no_create': True}"/>
                        <field name="h0" widget="float_time"/>
                        <field name="h1" widget="float_time"/>
                        <field name="h2" widget="float_time"/>
                        <field name="h3" widget="float_time"/>
                        <field name="h4" widget="float_time"/>
                        <field name="h5" widget="float_time"/>
                        <field name="h6" widget="float_time"/>
                        <field name="total" widget="float_time" sum="Total"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Registrar horas" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
