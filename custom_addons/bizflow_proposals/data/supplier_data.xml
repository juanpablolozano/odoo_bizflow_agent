<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="supplier_home_depot" model="bizflow.supplier">
        <field name="name">Home Depot</field>
        <field name="code">HOME_DEPOT</field>
        <field name="provider_type">website_search</field>
        <field name="website">https://www.homedepot.com</field>
        <field name="search_url_template">https://www.homedepot.com/s/{query}</field>
        <field name="sequence">10</field>
    </record>
    <record id="supplier_lowes" model="bizflow.supplier">
        <field name="name">Lowe's</field>
        <field name="code">LOWES</field>
        <field name="provider_type">website_search</field>
        <field name="website">https://www.lowes.com</field>
        <field name="search_url_template">https://www.lowes.com/search?searchTerm={query}</field>
        <field name="sequence">20</field>
    </record>
    <record id="supplier_manual" model="bizflow.supplier">
        <field name="name">Own catalog</field>
        <field name="code">OWN</field>
        <field name="provider_type">manual</field>
        <field name="sequence">5</field>
        <field name="notes">Use for contractor custom prices and imported materials.</field>
    </record>
</odoo>
