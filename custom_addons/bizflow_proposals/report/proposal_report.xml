<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_bizflow_proposal" model="ir.actions.report">
        <field name="name">Construction proposal PDF</field>
        <field name="model">bizflow.proposal</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bizflow_proposals.report_bizflow_proposal_document</field>
        <field name="print_report_name">'Proposal-%s' % (object.code or object.id)</field>
        <field name="binding_model_id" ref="model_bizflow_proposal"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_bizflow_proposal_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <t t-out="doc.render_html()"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
