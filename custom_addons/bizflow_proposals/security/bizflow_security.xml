<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bizflow" model="ir.module.category">
        <field name="name">BizFlow Proposals</field>
        <field name="sequence">25</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_bizflow">
        <field name="name">BizFlow Proposals</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_bizflow"/>
    </record>

    <record id="group_bizflow_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_bizflow"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_bizflow_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_bizflow"/>
        <field name="implied_ids" eval="[(4, ref('group_bizflow_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="seq_bizflow_proposal" model="ir.sequence">
        <field name="name">BizFlow Proposal</field>
        <field name="code">bizflow.proposal</field>
        <field name="prefix">PROP/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
