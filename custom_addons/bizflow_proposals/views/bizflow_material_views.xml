<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bizflow_material_list" model="ir.ui.view">
        <field name="name">bizflow.material.list</field>
        <field name="model">bizflow.material</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sku"/>
                <field name="category"/>
                <field name="supplier_id"/>
                <field name="list_price"/>
                <field name="cost_price"/>
                <field name="uom_name"/>
            </list>
        </field>
    </record>
    <record id="view_bizflow_material_form" model="ir.ui.view">
        <field name="name">bizflow.material.form</field>
        <field name="model">bizflow.material</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sku"/>
                        <field name="category"/>
                        <field name="supplier_id"/>
                        <field name="list_price"/>
                        <field name="cost_price"/>
                        <field name="uom_name"/>
                        <field name="product_url"/>
                        <field name="last_fetched_price"/>
                        <field name="notes"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_bizflow_material" model="ir.actions.act_window">
        <field name="name">Materials</field>
        <field name="res_model">bizflow.material</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
