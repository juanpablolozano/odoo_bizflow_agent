<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bizflow_pdf_template_list" model="ir.ui.view">
        <field name="name">bizflow.pdf.template.list</field>
        <field name="model">bizflow.pdf.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_default"/>
                <field name="primary_color"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_bizflow_pdf_template_form" model="ir.ui.view">
        <field name="name">bizflow.pdf.template.form</field>
        <field name="model">bizflow.pdf.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_default"/>
                        <field name="primary_color"/>
                        <field name="accent_color"/>
                        <field name="font_family"/>
                        <field name="header_html"/>
                        <field name="footer_html"/>
                        <field name="custom_css"/>
                        <field name="show_cover_image"/>
                        <field name="show_before_after"/>
                        <field name="show_utility"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_bizflow_pdf_template" model="ir.actions.act_window">
        <field name="name">PDF templates</field>
        <field name="res_model">bizflow.pdf.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
