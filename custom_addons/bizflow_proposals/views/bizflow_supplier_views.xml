<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bizflow_supplier_list" model="ir.ui.view">
        <field name="name">bizflow.supplier.list</field>
        <field name="model">bizflow.supplier</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="provider_type"/>
                <field name="website"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_bizflow_supplier_form" model="ir.ui.view">
        <field name="name">bizflow.supplier.form</field>
        <field name="model">bizflow.supplier</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="provider_type"/>
                        <field name="website"/>
                        <field name="search_url_template"/>
                        <field name="api_base_url"/>
                        <field name="api_key" password="True"/>
                        <field name="api_search_path"/>
                        <field name="api_headers_json"/>
                        <field name="result_mapping_json"/>
                        <field name="notes"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_bizflow_supplier" model="ir.actions.act_window">
        <field name="name">Suppliers</field>
        <field name="res_model">bizflow.supplier</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
