<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_bizflow" model="ir.ui.view">
        <field name="name">crm.lead.form.bizflow.proposals</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_bizflow_proposals" type="object"
                        class="oe_stat_button" icon="fa-file-text-o">
                    <field name="bizflow_proposal_count" widget="statinfo" string="Proposals"/>
                </button>
            </div>
            <xpath expr="//header" position="inside">
                <button name="action_create_bizflow_proposal" type="object"
                        string="Create proposal" class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>
