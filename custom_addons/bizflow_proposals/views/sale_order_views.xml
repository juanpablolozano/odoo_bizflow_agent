<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_bizflow" model="ir.ui.view">
        <field name="name">sale.order.form.bizflow.editor</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_bizflow_editor" type="object"
                        string="Open editor"
                        class="btn-primary"
                        invisible="state not in ('draft', 'sent')"/>
                <button name="action_sync_bizflow_lines" type="object"
                        string="Sync from editor"
                        class="btn-secondary"
                        invisible="state not in ('draft', 'sent') or not bizflow_proposal_count"/>
                <button name="action_preview_bizflow_pdf" type="object"
                        string="Construction PDF"
                        class="btn-secondary"
                        invisible="not bizflow_proposal_count"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_bizflow_editor" type="object"
                        class="oe_stat_button" icon="fa-pencil-square-o">
                    <field name="bizflow_proposal_count" widget="statinfo" string="Editor"/>
                </button>
            </xpath>
            <field name="partner_id" position="after">
                <field name="bizflow_proposal_id" invisible="1"/>
                <field name="bizflow_proposal_count" invisible="1"/>
            </field>
        </field>
    </record>

    <delete model="ir.ui.menu" id="menu_bizflow_new_quotation_editor"/>
    <delete model="ir.actions.server" id="action_bizflow_new_quotation_editor"/>
</odoo>
